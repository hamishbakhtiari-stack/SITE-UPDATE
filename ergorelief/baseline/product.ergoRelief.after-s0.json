        },
        "review_mAhrUk": {
          "type": "review",
          "settings": {
            "text": "“The lumbar support is the best I've ever used. It doesn't flatten out like the cheap ones from Amazon.”",
            "image": "shopify://shop_images/9d4ad869d29821c1caa655f1a2ff6cd3dd48ce79.jpg",
            "name": "Mark T.",
            "bio": "Verified customer"
          }
        },
        "review_36PpHk": {
          "type": "review",
