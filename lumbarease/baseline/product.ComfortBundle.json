    "faq_bMxpUE": {
      "type": "FAQ",
      "blocks": {
        "faq_7WFGwi": {
          "type": "faq",
          "settings": {
            "question": "Does it work for all chairs?",
            "answer": "Most of them — office, gaming, dining and car seats.\n\nErgoRelief™ sits on any flat seat. LumbarEase™ has adjustable straps, so it fits backrests with or without built-in lumbar support.\n\nThey work best on a chair with a flat seat and a backrest you can strap to."
          }
        },
        "faq_mBiBVG": {
          "type": "faq",
          "settings": {
            "question": "How fast will I feel results?",
            "answer": "Most people feel the pressure come off the first time they sit down.\n\nFull comfort usually takes a few days. Sitting properly uses muscles you haven't been using, so a short adjustment period is normal — it isn't a sign it isn't working.\n\nThat's what the 7-Day Reset is for. One short video a day, each building on the last, so the change sticks instead of wearing off."
          }
        },
        "faq_6NTqnJ": {
          "type": "faq",
          "settings": {
            "question": "Is it firm or soft?",
            "answer": "Firm — deliberately.\n\nSoft cushions feel great for ten minutes, then bottom out and put you straight back on your tailbone. High-density memory foam holds its shape, so the support at 5pm is the same as it was at 9am.\n\nIf every lumbar support you've tried has dug into your back, that's usually a too-thick one on a chair that already curves. LumbarEase™ is contoured to sit in the gap rather than push into it."
          }
        },
        "faq_EtRgqK": {
          "type": "faq",
          "settings": {
            "question": "What's included in the 7-Day Reset?",
            "answer": "A short video each day, plus the setup and habit changes that go with it.\n\n- Day-by-day video guidance, one per day\n- Practical setup tips for your chair, desk and screen\n- Simple movement and posture routines you can do at your desk\n\nEach day builds on the last, so by the end you have a setup and a routine that hold without you thinking about them."
          }
        },
        "faq_Mt6Leh": {
          "type": "faq",
          "settings": {
            "question": "How do I access the 7-Day Reset?",
            "answer": "It's emailed to you after your order — no app, no login.\n\nEach day is one short video and one adjustment to make, about 2–3 minutes."
          }
        },
        "faq_Prjczy": {
          "type": "faq",
          "settings": {
            "question": "Shipping & returns?",
            "answer": "Shipping\nFree express shipping across Australia, dispatched from our Sydney warehouse. Most orders arrive in 2–3 business days, and tracking is emailed the moment your order ships.\n\nReturns\n30-day money-back guarantee. If it's not right for you, email info@sitcomfort.com.au within 30 days and we'll take care of it."
          }
        }
      },
