<section 
  class="feature-highlight-section{% if section.settings.two_up_desktop %} fh-v2{% endif %}"
  style="
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  "
>
  <div class="page-width">
    <div class="feature-highlight-wrapper image-{{ section.settings.image_position }}">
      
      <!-- Image Side -->
      <div class="feature-image-column">
        {% if section.settings.main_image != blank %}
          {%- assign fh_image_alt = section.settings.image_alt | default: 'Feature Image' -%}
          <div class="feature-main-image">
            {% comment %} ComfortBundle's CSS shows this image at 260px on phones (up to ~380px on bigger screens); other pages show it full width and keep the original tag {% endcomment %}
            {% if template == 'product.ComfortBundle' %}
            {{
              section.settings.main_image
              | image_url: width: 800
              | image_tag: loading: 'lazy', alt: fh_image_alt, widths: '260, 390, 520, 780', sizes: '(min-width: 750px) 380px, 260px'
            }}
            {% else %}
            {{
              section.settings.main_image
              | image_url: width: 800
              | image_tag: loading: 'lazy', alt: fh_image_alt
            }}
            {% endif %}
          </div>
        {% endif %}
      </div>

      <!-- Content Side -->
      <div class="feature-content-column">
        
        {% if section.settings.heading != blank %}
          <h2 class="heading-h2">
            {{ section.settings.heading }} {% if section.settings.heading_span != blank %}
            <span>{{ section.settings.heading_span }}</span>
          {% endif %}
          </h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <h6 class="sub-heading-high">
            {{ section.settings.subheading }} 
          </h6>
        {% endif %}
        <div class="feature-grid">
          {% for block in section.blocks %}
            <div class="feature-item" {{ block.shopify_attributes }}>
              
              {% if block.settings.icon != blank %}
                <div class="feature-icon">
                  {{
                    block.settings.icon
                    | image_url: width: 100
                    | image_tag: loading: 'lazy', alt: block.settings.title
                  }}
                </div>
              {% endif %}

              {% if block.settings.title != blank %}
                <h4 class="feature-title">
                  {{ block.settings.title }}
                </h4>
              {% endif %}

            </div>
          {% endfor %}
        </div>

      </div>

    </div>
  </div>

  {% if section.settings.corner_image != blank %}
    <div class="corner-image">
      {{
        section.settings.corner_image
        | image_url: width: 300
        | image_tag: loading: 'lazy', alt: ''
      }}
    </div>
  {% endif %}
</section>

<style>

@media screen and (max-width: 991px){

  .feature-highlight-section{
    padding-top: {{ section.settings.padding_top_mobile }}px !important;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px !important;
  }
}

{% if section.settings.two_up_desktop %}
/* --- v2: two-up feature grid from 992px (opt-in per section) --- */
@media screen and (min-width: 992px){

  .feature-highlight-section.fh-v2 .feature-grid{
    grid-template-columns: repeat(2, 1fr) !important;
  }
}
{% endif %}

</style>

{% schema %}
{
  "name": "Feature Highlight",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f7f7f7"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop Padding Top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop Padding Bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile Padding Top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile Padding Bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "default": "right",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "two_up_desktop",
      "label": "Two columns on desktop",
      "info": "Lays the feature list out 2 across from 992px up. Leave off for the theme default.",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Main image alt text",
      "info": "Describes the image for screen readers and Google Images. Leave blank to use the default."
    },
    {
      "type": "image_picker",
      "id": "corner_image",
      "label": "Corner Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed For People Who Sit All Day"
    },
    {
    "type": "text",
    "id": "heading_span",
    "label": "Highlight Text",
    "default": "Highlight Text"
    },
    {
    "type": "text",
    "id": "subheading",
    "label": "Sub heading"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Feature Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Heading",
          "default": "Feature Heading"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Highlight",
      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{% endschema %}
